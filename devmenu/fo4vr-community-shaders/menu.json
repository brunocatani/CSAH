              "controls": [
                { "id": "mode", "type": "choice", "label": "Execution Mode", "default": 0, "choices": [ { "label": "DLAA Native", "value": 0 }, { "label": "DLSS Quality", "value": 1 }, { "label": "DLSS Balanced", "value": 2 }, { "label": "DLSS Performance", "value": 3 }, { "label": "DLSS Ultra Performance", "value": 4 }, { "label": "Center DLAA + TAA", "value": 5 } ], "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "iMode" } },
                { "id": "model", "type": "choice", "label": "Transformer Model", "default": 2, "choices": [ { "label": "Automatic", "value": 0 }, { "label": "Reduced Ghosting J", "value": 1 }, { "label": "Quality K", "value": 2 }, { "label": "Stable L", "value": 3 }, { "label": "Performance M", "value": 4 } ], "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "iModelPreset" } },
                { "id": "motion-repair", "type": "toggle", "label": "Motion Vector Repair", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "bMotionVectorRepair" } },
                { "id": "post-sharpening", "type": "toggle", "label": "Post Sharpening", "default": false, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "bPostSharpening" } },
                { "id": "sharpness", "type": "slider", "label": "Sharpness", "default": 0.25, "min": 0.0, "max": 1.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "fSharpness" } }
              ]
            },
            {
              "id": "center-region",
              "label": "Center DLAA region",
              "controls": [
                { "id": "center-width", "type": "slider", "label": "Center Width", "default": 0.55, "min": 0.25, "max": 1.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "fCenterWidth" } },
                { "id": "center-height", "type": "slider", "label": "Center Height", "default": 0.55, "min": 0.25, "max": 1.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "fCenterHeight" } },
                { "id": "center-feather", "type": "slider", "label": "Center Feather Pixels", "default": 48.0, "min": 0.0, "max": 128.0, "step": 1.0, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "fCenterFeatherPixels" } },
                { "id": "visualize-center", "type": "toggle", "label": "Visualize Center Region", "default": false, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "bVisualizeCenter" } },
                { "id": "hard-reset", "type": "toggle", "label": "Hard Reset On Load", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "bHardResetOnLoad" } },
                { "id": "verbose-diagnostics", "type": "toggle", "label": "Verbose Diagnostics", "default": false, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "bVerboseDiagnostics" } }
              ]
