              "controls": [
                { "id": "native-shadows-enabled", "type": "toggle", "label": "Native Shadow Fixes", "help": "Restart required.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "NativeShadows", "key": "bEnabled" } },
                { "id": "extended-cascades", "type": "toggle", "label": "Extended Directional Cascades", "help": "Restart required.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "NativeShadows", "key": "bExtendedDirectionalCascades" } },
                { "id": "tiled-lighting", "type": "toggle", "label": "Tiled Deferred Lighting", "help": "Restart required.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "NativeShadows", "key": "bTiledDeferredLighting" } },
                { "id": "shadow-distance", "type": "number", "label": "Directional Shadow Distance", "help": "Restart required.", "default": 15000.0, "min": 3000.0, "max": 50000.0, "step": 250.0, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "NativeShadows", "key": "fDirectionalShadowDistance" } },
                { "id": "cascade-blend", "type": "number", "label": "Cascade Blend Distance", "help": "Restart required.", "default": 100.0, "min": 0.0, "max": 5000.0, "step": 25.0, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "NativeShadows", "key": "fCascadeBlendDistance" } },
                { "id": "shadow-filter", "type": "number", "label": "Orthographic Shadow Filter", "help": "Restart required; accepted engine range is 0 through 5.", "default": 3, "min": 0, "max": 5, "step": 1, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "NativeShadows", "key": "iOrthographicShadowFilter" } }
              ]
            }
          ]
        },
