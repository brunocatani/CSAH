{
  "$schema": "../../menu.schema.json",
  "schemaVersion": 1,
  "id": "fo4vr.community-shaders",
  "name": "FO4VR Community Shaders",
  "version": "0.2.0",
  "description": "Live controls for the FO4VR-native lighting, material, shadow, and image-quality stack. The original Community Shaders wrist panel remains independent and can be disabled separately.",
  "accent": "#F0A04B",
  "tabs": [
    {
      "id": "features",
      "label": "Features",
      "pages": [
        {
          "id": "lighting",
          "label": "Lighting",
          "groups": [
            {
              "id": "core-lighting",
              "label": "Core lighting",
              "description": "Master feature gates are applied live by the Community Shaders shared-INI bridge.",
              "controls": [
                { "id": "linear-lighting", "type": "toggle", "label": "Linear Lighting", "help": "Evaluates supported lighting and material colour operations in linear space.", "default": false, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "bEnabled" } },
                { "id": "native-darkness", "type": "toggle", "label": "Preserve Native Darkness", "help": "Keeps native light, ambient, fog, and sky producers at Fallout's darker response floor.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "bPreserveNativeDarkness" } },
                { "id": "ibl", "type": "toggle", "label": "Image Based Lighting", "help": "Enables validated environment lighting and material reflections.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ImageBasedLighting", "key": "bEnabled" } },
                { "id": "diffuse-ibl", "type": "toggle", "label": "Diffuse IBL", "help": "Adds environment-derived diffuse bounce lighting.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ImageBasedLighting", "key": "bDiffuseEnabled" } },
                { "id": "cloud-shadows", "type": "toggle", "label": "Cloud Shadows", "help": "Projects captured cloud cover along the directional light.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "CloudShadows", "key": "bEnabled" } }
              ]
            }
          ]
        },
        {
          "id": "materials",
          "label": "Materials",
          "groups": [
            {
              "id": "material-features",
              "label": "Material features",
              "controls": [
                { "id": "complex-environment", "type": "toggle", "label": "Complex Metal Response", "help": "Enables complex-material environment response when validated IBL data is available.", "default": false, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ComplexMaterials", "key": "bEnableEnvironmentResponse" } },
                { "id": "complex-parallax", "type": "toggle", "label": "Complex Parallax", "help": "Enables parallax on assets authored for the Community Shaders complex-material contract.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ComplexMaterials", "key": "bEnableParallax" } },
                { "id": "wrapped-grass", "type": "toggle", "label": "Wrapped Grass Lighting", "help": "Wraps directional light around classified grass blades.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "WrappedGrassLighting", "key": "bEnabled" } },
                { "id": "hair-specular", "type": "toggle", "label": "Hair Specular", "help": "Enables classified anisotropic hair highlights.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "HairSpecular", "key": "bEnabled" } },
                { "id": "subsurface-scattering", "type": "toggle", "label": "Subsurface Scattering", "help": "Enables depth-aware diffusion on classified skin and face materials.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "SubsurfaceScattering", "key": "bEnabled" } },
                { "id": "basic-wetness", "type": "toggle", "label": "Basic Wetness", "help": "Applies the manual wet-state material response to classified wettable surfaces.", "default": false, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "BasicWetness", "key": "bEnabled" } }
              ]
            }
          ]
        },
        {
          "id": "shadows",
          "label": "Shadows",
          "groups": [
            {
              "id": "contact",
              "label": "Contact shadows",
              "controls": [
                { "id": "contact-shadows", "type": "toggle", "label": "Contact Shadows", "help": "Adds short-range screen-space directional occlusion.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ContactShadows", "key": "bEnabled" } },
                { "id": "contact-foveated", "type": "toggle", "label": "Foveated Sampling", "help": "Reduces contact-shadow work outside the center view without changing center fidelity.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ContactShadows", "key": "bFoveated" } }
              ]
            }
          ]
        },
        {
          "id": "image-quality",
          "label": "Image Quality",
          "groups": [
            {
              "id": "upscaling-feature",
              "label": "Neural image quality",
              "controls": [
                { "id": "dlaa", "type": "toggle", "label": "DLAA / DLSS", "help": "Enables the selected Streamline image-quality mode.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "DLAA", "key": "bEnabled" } }
              ]
            },
            {
              "id": "vanilla-master",
              "label": "Vanilla renderer fixes",
              "controls": [
                { "id": "vanilla-fixes", "type": "toggle", "label": "Vanilla Fixes", "help": "Master gate for the verified FO4VR renderer corrections.", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "VanillaFixes", "key": "bEnabled" } }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "linear",
      "label": "Linear",
      "pages": [
        {
          "id": "response",
          "label": "Response",
          "groups": [
            {
              "id": "gamma",
              "label": "Response gamma",
              "description": "Advanced response controls. Defaults match the verified FO4VR shader contracts.",
              "controls": [
                { "id": "light-gamma", "type": "slider", "label": "Light Gamma", "default": 1.8, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fLightGamma" } },
                { "id": "color-gamma", "type": "slider", "label": "Encoded Colour Gamma", "default": 1.8, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fColorGamma" } },
                { "id": "emission-gamma", "type": "slider", "label": "Emission Gamma", "default": 1.8, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fEmitColorGamma" } },
                { "id": "glowmap-gamma", "type": "slider", "label": "Glowmap Gamma", "default": 1.8, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fGlowmapGamma" } },
                { "id": "ambient-gamma", "type": "slider", "label": "Ambient Gamma", "default": 1.8, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fAmbientGamma" } },
                { "id": "fog-gamma", "type": "slider", "label": "Fog Gamma", "default": 1.97, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fFogGamma" } },
                { "id": "fog-alpha-gamma", "type": "slider", "label": "Fog Alpha Gamma", "default": 1.8, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fFogAlphaGamma" } },
                { "id": "effect-gamma", "type": "slider", "label": "Effect Gamma", "default": 1.4, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fEffectGamma" } },
                { "id": "effect-alpha-gamma", "type": "slider", "label": "Effect Alpha Gamma", "default": 1.55, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fEffectAlphaGamma" } },
                { "id": "sky-gamma", "type": "slider", "label": "Sky Gamma", "default": 1.8, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fSkyGamma" } },
                { "id": "water-gamma", "type": "slider", "label": "Water Gamma", "default": 1.8, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fWaterGamma" } },
                { "id": "volumetric-gamma", "type": "slider", "label": "Volumetric Lighting Gamma", "default": 1.8, "min": 0.1, "max": 3.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fVolumetricLightingGamma" } }
              ]
            }
          ]
        },
        {
          "id": "energy",
          "label": "Energy",
          "groups": [
            {
              "id": "multipliers",
              "label": "Energy multipliers",
              "controls": [
                { "id": "diffuse-level", "type": "slider", "label": "Vanilla Diffuse", "default": 1.0, "min": 0.0, "max": 10.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fVanillaDiffuseColorMultiplier" } },
                { "id": "directional-level", "type": "slider", "label": "Directional Light", "default": 1.0, "min": 0.0, "max": 10.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fDirectionalLightMultiplier" } },
                { "id": "point-level", "type": "slider", "label": "Point Light", "default": 1.0, "min": 0.0, "max": 10.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fPointLightMultiplier" } },
                { "id": "ambient-level", "type": "slider", "label": "Ambient Light", "default": 1.0, "min": 0.0, "max": 10.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fAmbientMultiplier" } },
                { "id": "emission-level", "type": "slider", "label": "Emission", "default": 1.0, "min": 0.0, "max": 10.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fEmitColorMultiplier" } },
                { "id": "glow-level", "type": "slider", "label": "Glowmap", "default": 0.66, "min": 0.0, "max": 10.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fGlowmapMultiplier" } },
                { "id": "effect-lighting-level", "type": "slider", "label": "Effect Lighting", "default": 0.32, "min": 0.0, "max": 10.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fEffectLightingMultiplier" } },
                { "id": "membrane-level", "type": "slider", "label": "Membrane Effects", "default": 1.0, "min": 0.0, "max": 10.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fMembraneEffectMultiplier" } },
                { "id": "other-effect-level", "type": "slider", "label": "Other Effects", "default": 1.0, "min": 0.0, "max": 10.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "LinearLighting", "key": "fOtherEffectMultiplier" } }
              ]
            },
            {
              "id": "ibl-energy",
              "label": "Environment energy",
              "controls": [
                { "id": "diffuse-ibl-level", "type": "slider", "label": "Diffuse IBL Level", "default": 1.0, "min": 0.0, "max": 2.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ImageBasedLighting", "key": "fDiffuseLevel" } }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "tuning",
      "label": "Tuning",
      "pages": [
        {
          "id": "surfaces",
          "label": "Surfaces",
          "groups": [
            {
              "id": "grass-hair",
              "label": "Grass and hair",
              "controls": [
                { "id": "grass-wrap", "type": "slider", "label": "Grass Light Wrap", "default": 0.5, "min": 0.0, "max": 1.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "WrappedGrassLighting", "key": "fWrapAmount" } },
                { "id": "hair-highlight", "type": "slider", "label": "Hair Highlight", "default": 1.6, "min": 0.0, "max": 4.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "HairSpecular", "key": "fSpecularMultiplier" } }
              ]
            },
            {
              "id": "skin",
              "label": "Skin scattering",
              "controls": [
                { "id": "skin-strength", "type": "slider", "label": "Scattering Strength", "default": 0.55, "min": 0.0, "max": 1.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "SubsurfaceScattering", "key": "fStrength" } },
                { "id": "skin-radius", "type": "slider", "label": "Scattering Radius", "default": 2.0, "min": 0.25, "max": 5.0, "step": 0.05, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "SubsurfaceScattering", "key": "fRadiusPixels" } },
                { "id": "skin-depth-rejection", "type": "slider", "label": "Depth Rejection", "default": 0.003, "min": 0.0001, "max": 0.05, "step": 0.0001, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "SubsurfaceScattering", "key": "fDepthRejection" } }
              ]
            },
            {
              "id": "wetness",
              "label": "Wetness",
              "controls": [
                { "id": "wetness-amount", "type": "slider", "label": "Wetness Amount", "default": 0.65, "min": 0.0, "max": 1.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "BasicWetness", "key": "fWetness" } },
                { "id": "wetness-darkening", "type": "slider", "label": "Diffuse Darkening", "default": 0.18, "min": 0.0, "max": 0.75, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "BasicWetness", "key": "fDiffuseDarkening" } },
                { "id": "wetness-specular", "type": "slider", "label": "Specular Multiplier", "default": 1.6, "min": 0.0, "max": 4.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "BasicWetness", "key": "fSpecularMultiplier" } },
                { "id": "wetness-roughness", "type": "slider", "label": "Roughness Scale", "default": 0.35, "min": 0.05, "max": 1.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "BasicWetness", "key": "fRoughnessScale" } }
              ]
            },
            {
              "id": "clouds",
              "label": "Cloud response",
              "controls": [
                { "id": "cloud-opacity", "type": "slider", "label": "Cloud Shadow Opacity", "default": 0.55, "min": 0.0, "max": 1.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "CloudShadows", "key": "fOpacity" } }
              ]
            }
          ]
        },
        {
          "id": "contact-shadows",
          "label": "Contact Shadows",
          "groups": [
            {
              "id": "contact-response",
              "label": "Contact response",
              "controls": [
                { "id": "strength", "type": "slider", "label": "Shadow Strength", "default": 0.85, "min": 0.0, "max": 1.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ContactShadows", "key": "fStrength" } },
                { "id": "ray-distance", "type": "slider", "label": "Ray Distance", "default": 96.0, "min": 8.0, "max": 256.0, "step": 1.0, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ContactShadows", "key": "fMaxDistance" } },
                { "id": "fade-distance", "type": "slider", "label": "View Fade Distance", "default": 2048.0, "min": 256.0, "max": 8192.0, "step": 64.0, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ContactShadows", "key": "fFadeDistance" } },
                { "id": "thickness", "type": "slider", "label": "Surface Thickness", "default": 0.012, "min": 0.002, "max": 0.05, "step": 0.001, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ContactShadows", "key": "fThickness" } },
                { "id": "samples", "type": "number", "label": "Center Samples", "default": 8, "min": 2, "max": 16, "step": 1, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ContactShadows", "key": "iSampleCount" } }
              ]
            }
          ]
        },
        {
          "id": "complex-materials",
          "label": "Complex Materials",
          "groups": [
            {
              "id": "parallax",
              "label": "Parallax",
              "controls": [
                { "id": "quality", "type": "choice", "label": "Parallax Quality", "default": 1, "choices": [ { "label": "Low", "value": 0 }, { "label": "Medium", "value": 1 }, { "label": "High", "value": 2 } ], "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ComplexMaterials", "key": "iParallaxQuality" } },
                { "id": "depth", "type": "slider", "label": "Parallax Depth", "default": 0.035, "min": 0.0, "max": 0.2, "step": 0.001, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ComplexMaterials", "key": "fParallaxDepth" } },
                { "id": "grazing-clamp", "type": "slider", "label": "Grazing Clamp", "default": 0.18, "min": 0.05, "max": 1.0, "step": 0.01, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ComplexMaterials", "key": "fParallaxGrazingClamp" } },
                { "id": "fade-start", "type": "number", "label": "Fade Start", "default": 2048.0, "min": 0.0, "max": 65536.0, "step": 64.0, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ComplexMaterials", "key": "fParallaxFadeStart" } },
                { "id": "fade-end", "type": "number", "label": "Fade End", "default": 8192.0, "min": 1.0, "max": 131072.0, "step": 64.0, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "ComplexMaterials", "key": "fParallaxFadeEnd" } }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "engine",
      "label": "Engine",
      "pages": [
        {
          "id": "vanilla-fixes",
          "label": "Vanilla Fixes",
          "groups": [
            {
              "id": "renderer-gates",
              "label": "Verified renderer gates",
              "controls": [
                { "id": "precipitation", "type": "toggle", "label": "Precipitation Occlusion", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "VanillaFixes", "key": "bPrecipitationOcclusion" } },
                { "id": "image-space", "type": "toggle", "label": "Image Space Modifiers", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "VanillaFixes", "key": "bAllowImageSpaceModifiers" } },
                { "id": "sao", "type": "toggle", "label": "Stereo SAO", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "VanillaFixes", "key": "bVrAllowSAO" } },
                { "id": "ssr", "type": "toggle", "label": "Screen-Space Reflections", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "VanillaFixes", "key": "bVrAllowScreenSpaceReflections" } },
                { "id": "screen-space-sss", "type": "toggle", "label": "Screen-Space SSS", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "VanillaFixes", "key": "bVrAllowScreenSpaceSubsurfaceScattering" } },
                { "id": "lens-flare", "type": "toggle", "label": "VR Lens Flare", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "VanillaFixes", "key": "bLensFlareVr" } },
                { "id": "focus-shadows", "type": "toggle", "label": "Focus Shadows", "default": true, "binding": { "type": "ini", "root": "documents", "path": "FO4VRCommunityShaders_Config/FO4VRCommunityShaders.ini", "section": "VanillaFixes", "key": "bVrAllowFocusShadows" } },
